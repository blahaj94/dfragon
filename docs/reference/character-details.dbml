// Paste into dbdiagram.io. Canonical mapping: apps/api/src/database/schemas.
Enum character_data_section {
  basic
  status
  equipment
  avatar
  creature
  oath
  mist_assimilation
  skill_style
  buff_equipment
  buff_avatar
  buff_creature
}

Table characters {
  character_id text [pk, not null]
  server_id text [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table character_api_responses {
  character_id text [not null]
  section character_data_section [not null]
  payload jsonb [not null, note: 'Full response object; latest successful value only']
  revision integer [not null, default: 1, note: 'Increases only when JSONB changes']
  content_updated_at timestamptz [not null]
  last_successful_fetch_at timestamptz [not null]
  request_started_at timestamptz [not null, note: 'Rejects older refresh writes']

  indexes {
    (character_id, section) [pk]
  }
}

Ref: character_api_responses.character_id > characters.character_id [delete: cascade]

Table item_catalog {
  item_id text [pk, not null]
  payload jsonb [not null, note: 'Shared item detail; never replaces equipped state']
  fetched_at timestamptz [not null]
  expires_at timestamptz [not null, note: '24 hours after successful fetch; may be invalidated earlier']
  request_started_at timestamptz [not null, note: 'Rejects older refresh writes']
}

Table skill_catalog {
  job_id text [not null]
  skill_id text [not null]
  payload jsonb [not null, note: 'Shared skill detail, identified by the single request']
  fetched_at timestamptz [not null]
  expires_at timestamptz [not null]
  request_started_at timestamptz [not null]

  indexes {
    (job_id, skill_id) [pk]
  }
}

Table set_item_catalog {
  set_item_id text [pk, not null]
  payload jsonb [not null, note: 'Shared set definition; not the character active set state']
  fetched_at timestamptz [not null]
  expires_at timestamptz [not null]
  request_started_at timestamptz [not null]
}
