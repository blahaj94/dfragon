{
  "name": "@dfragon/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./tokens.css",
    "./tokens.stylex": "./src/tokens.stylex.ts",
    "./foundation.css": "./foundation.css",
    "./typo": {
      "types": "./dist/typo.d.ts",
      "import": "./dist/typo.js"
    },
    "./stylex-config": "./stylex.config.ts"
  },
  "scripts": {
    "test": "pnpm typecheck && vitest run && pnpm test:tooling",
    "test:tooling": "node --test test/build-verification.node.mjs test/tokens.node.mjs",
    "test:consumer-lifecycle": "node --test --test-timeout=25000 test/consumer-process-lifecycle.node.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint",
    "build": "vite build && tsc -p tsconfig.build.json && pnpm verify:build",
    "verify:build": "node scripts/verify-build.mjs library dist && tsc -p test/build-consumer/tsconfig.json && vite build --config test/build-consumer/vite.config.ts && node --test test/build-exports.node.mjs",
    "dev:examples": "vite --config examples/vite.config.ts",
    "build:examples": "vite build --config examples/vite.config.ts",
    "preview:examples": "vite preview --config examples/vite.config.ts",
    "lint:fix": "biome lint --write",
    "format": "biome format --write && node ../../scripts/statement-spacing.mjs --write",
    "format:check": "biome format && node ../../scripts/statement-spacing.mjs --check"
  },
  "peerDependencies": {
    "@base-ui/react": "catalog:",
    "@stylexjs/stylex": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@base-ui/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "typescript-compiler-api": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "@types/node": "catalog:",
    "@dfragon/licenses": "workspace:*",
    "@stylexjs/stylex": "catalog:",
    "@stylexjs/unplugin": "catalog:"
  },
  "files": [
    "dist",
    "README.md",
    "tokens.css",
    "src/tokens.stylex.ts",
    "foundation.css",
    "stylex.config.ts"
  ]
}
