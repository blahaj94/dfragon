{
  "name": "@dfragon/lib",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./ocr-contract": {
      "types": "./dist/ocr-contract.d.ts",
      "import": "./dist/ocr-contract.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./utils/ip-quota-key": {
      "types": "./dist/utils/ip-quota-key.d.ts",
      "import": "./dist/utils/ip-quota-key.js"
    },
    "./utils/pagination": {
      "types": "./dist/utils/pagination.d.ts",
      "import": "./dist/utils/pagination.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSES",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && dfragon-copy-notices lib dist/notices && dfragon-copy-notices lib LICENSES",
    "test": "pnpm build && node --test test/*.test.mjs",
    "generate:cp949": "node scripts/generate-cp949.mjs",
    "lint": "biome lint",
    "format:check": "biome format && node ../../scripts/statement-spacing.mjs --check"
  },
  "dependencies": {
    "ipaddr.js": "2.5.0"
  },
  "devDependencies": {
    "iconv-lite": "0.7.3",
    "typescript": "6.0.2",
    "@dfragon/licenses": "workspace:*"
  }
}
