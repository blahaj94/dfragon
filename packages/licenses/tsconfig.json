{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "allowJs": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "src/**/*.mjs"]
}
