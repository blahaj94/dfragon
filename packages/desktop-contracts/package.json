{
  "name": "@dfragon/desktop-contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*": "./src/*.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "pnpm typecheck && vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint",
    "format": "biome format --write && node ../../scripts/statement-spacing.mjs --write",
    "format:check": "biome format && node ../../scripts/statement-spacing.mjs --check"
  },
  "dependencies": {
    "@dfragon/lib": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
