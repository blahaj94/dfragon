{
  "name": "@dfragon/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "biome lint",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "lint:fix": "biome lint --write",
    "format": "biome format --write && node ../../scripts/statement-spacing.mjs --write",
    "format:check": "biome format && node ../../scripts/statement-spacing.mjs --check"
  },
  "dependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "@base-ui/react": "catalog:",
    "@dfragon/ui": "workspace:*",
    "@stylexjs/stylex": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "jsdom": "catalog:",
    "@dfragon/licenses": "workspace:*",
    "@stylexjs/unplugin": "catalog:"
  }
}
