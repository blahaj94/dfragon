{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "src/backend/**/*",
    "src/preload/**/*"
  ],
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "types": [
      "electron-vite/node"
    ],
    "allowImportingTsExtensions": true,
    "paths": {
      "@dfragon/lib": [
        "../../packages/lib/src/index.ts"
      ]
    }
  }
}
