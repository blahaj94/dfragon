# 개발 실행(pnpm dev)의 셸 설정이다. 설치 패키지는 이 값을 읽지 않고 build/channels.json의 채널 값을 쓴다.
# 검색 API origin. 없으면 검색을 사용할 수 없다.
DFRAGON_API_ORIGIN=https://localhost:3443
# 로그인용 accounts origin과 다섯 DFRAGON_AUTH_* 값. 하나라도 없으면 로그인 없이 실행한다.
DFRAGON_AUTH_API_ORIGIN=https://localhost:3444
DFRAGON_AUTH_ENVIRONMENT=development
DFRAGON_AUTH_PROVIDERS=passkey
# 설치한 개발 앱(dfragon.dev)과 profile, 단일 인스턴스 lock이 겹치지 않도록 별도 identity와 경로를 쓴다.
DFRAGON_AUTH_APP_IDENTITY=dfragon.local
DFRAGON_AUTH_USER_DATA_PATH=/absolute/path/outside-repository/dfragon-local-profile
