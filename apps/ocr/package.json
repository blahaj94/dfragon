{
  "name": "@dfragon/ocr",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.browser.json && node browser/build.mjs",
    "start": "node dist/src/main.js",
    "dev": "pnpm build && node --env-file=.env dist/src/main.js",
    "test": "pnpm build && node --test dist/test/*.test.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.browser.json",
    "test:ui": "pnpm build && node test-support/ui-smoke.mjs"
  },
  "dependencies": {
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "@seed-design/css": "2.7.0",
    "@stylexjs/stylex": "catalog:",
    "@tanstack/react-query": "5.103.2",
    "cookie-parser": "1.4.7",
    "express": "5.2.1",
    "pngjs": "7.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "tar-stream": "3.1.7"
  },
  "devDependencies": {
    "@dfragon/licenses": "workspace:*",
    "@dfragon/ui": "workspace:*",
    "@stylexjs/unplugin": "catalog:",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/tar-stream": "3.1.4",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
