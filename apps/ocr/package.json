{
  "name": "@dfragon/ocr",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.11.1 <27"
  },
  "scripts": {
    "build": "pnpm --filter @dfragon/lib build && tsc -p tsconfig.json && tsc -p tsconfig.browser.json && node browser/build.mjs",
    "start": "node dist/src/main.js",
    "dev": "pnpm build && node --env-file=.env dist/src/main.js",
    "test": "pnpm build && node --test dist/test/*.test.js",
    "lint": "biome lint",
    "typecheck": "pnpm --filter @dfragon/lib build && tsc --noEmit && tsc -p tsconfig.browser.json",
    "test:ui": "pnpm build && node test-support/ui-smoke.mjs",
    "test:browser": "vitest run"
  },
  "dependencies": {
    "@dfragon/lib": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@seed-design/css": "catalog:",
    "@stylexjs/stylex": "catalog:",
    "@tanstack/react-query": "catalog:",
    "cookie-parser": "catalog:",
    "express": "catalog:",
    "pngjs": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "reflect-metadata": "catalog:",
    "remeda": "catalog:",
    "rxjs": "catalog:",
    "tar-stream": "catalog:"
  },
  "devDependencies": {
    "@dfragon/licenses": "workspace:*",
    "@dfragon/ui": "workspace:*",
    "@stylexjs/unplugin": "catalog:",
    "@types/cookie-parser": "catalog:",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "@types/pngjs": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/tar-stream": "catalog:",
    "esbuild": "catalog:",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
