{
  "name": "@dfragon/ocr",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "dev": "pnpm build && node --env-file=.env dist/src/main.js",
    "test": "pnpm build && node --test dist/test/*.test.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "5.2.1",
    "pngjs": "7.0.0",
    "tar-stream": "3.1.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@seed-design/css": "2.7.0"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "@types/pngjs": "6.0.5",
    "@types/tar-stream": "3.1.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "typescript": "5.9.3",
    "esbuild": "0.28.2",
    "@dfragon/ui": "workspace:*",
    "@dfragon/licenses": "workspace:*"
  }
}
