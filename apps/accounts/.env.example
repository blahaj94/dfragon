PORT=3444
DB_HOST=127.0.0.1
DB_PORT=54330
DB_USERNAME=dfragon_accounts_local
# Set exactly one of DB_PASSWORD or DB_PASSWORD_FILE. File paths must be absolute.
DB_PASSWORD=<local-database-password>
# DB_PASSWORD_FILE=/absolute/path/outside-repository/db-password
DB_NAME=dfragon_accounts_local
AUTH_CONFIG_FILE=/absolute/path/outside-repository/auth.json
# With an external key, auth.json accessJwt.signingKey must contain only kid.
# Set exactly one external input, or keep privateKeyPem only in auth.json.
# AUTH_JWT_PRIVATE_KEY=<PKCS8-PEM-private-key>
# AUTH_JWT_PRIVATE_KEY_FILE=/absolute/path/outside-repository/jwt-private-key.pem
LOCAL_HTTPS_CERT_FILE=/absolute/path/outside-repository/localhost.pem
LOCAL_HTTPS_KEY_FILE=/absolute/path/outside-repository/localhost-key.pem
