[Unit]
Description=DFRAGON expired authentication data cleanup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/dfragon-accounts-current/deploy/accounts
ExecStart=/usr/bin/docker compose --project-name dfragon-accounts --env-file /etc/dfragon/accounts.env --profile maintenance run --rm --no-deps cleanup
TimeoutStartSec=15min
